# Clinical Coding X - Environment Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# LLM PROVIDER SETTINGS
# =============================================================================
# Provider options: openai, ollama, lm_studio, azure, anthropic, custom
LLM_PROVIDER=openai

# Model identifier
LLM_MODEL=gpt-4o-mini

# API Key (required for OpenAI, Azure, Anthropic)
LLM_API_KEY=your-api-key-here

# API Base URL
LLM_API_BASE=https://api.openai.com/v1

# Generation parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_CONTEXT_LENGTH=128000
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=3

# =============================================================================
# PROVIDER-SPECIFIC EXAMPLES
# =============================================================================

# --- Ollama (Local) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3
# LLM_API_BASE=http://localhost:11434

# --- LM Studio (Local) ---
# LLM_PROVIDER=lm_studio
# LLM_MODEL=local-model
# LLM_API_BASE=http://localhost:1234/v1

# =============================================================================
# SNOMED API SETTINGS (legacy HTTP tx-api)
# =============================================================================
SNOMED_API_BASE_URL=http://localhost:8010
SNOMED_API_TIMEOUT=30.0

# =============================================================================
# SNOMED gRPC SERVICE SETTINGS (snomed-service)
# =============================================================================
# gRPC address of the SNOMED service (default: localhost:50051)
SNOMED_GRPC_ADDRESS=localhost:50051
SNOMED_GRPC_TIMEOUT=30.0
