# Clinical Coding X - Environment Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# gRPC SERVER SETTINGS
# =============================================================================
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# =============================================================================
# LLM PROVIDER SETTINGS
# =============================================================================
# Provider options: openai, ollama, lm_studio, azure, anthropic, custom
LLM_PROVIDER=openai

# Model identifier with provider prefix
# Examples:
#   - openai/gpt-4o-mini (default)
#   - openai/gpt-4o
#   - ollama/llama3
#   - ollama/mistral
#   - lm_studio/local-model
#   - azure/your-deployment-name
#   - anthropic/claude-3-sonnet
LLM_MODEL=openai/gpt-4o-mini

# API Key (required for OpenAI, Azure, Anthropic; not needed for local providers)
LLM_API_KEY=

# API Base URL (required for Ollama, LM Studio, custom endpoints)
# Examples:
#   - Ollama: http://localhost:11434
#   - LM Studio: http://localhost:1234/v1
#   - Custom: http://your-server:8000/v1
LLM_API_BASE=

# Request settings
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=3

# =============================================================================
# PROVIDER-SPECIFIC EXAMPLES
# =============================================================================

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=sk-your-openai-key
# LLM_API_BASE=

# --- Ollama (Local) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=ollama/llama3
# LLM_API_KEY=
# LLM_API_BASE=http://localhost:11434

# --- LM Studio (Local) ---
# LLM_PROVIDER=lm_studio
# LLM_MODEL=lm_studio/local-model
# LLM_API_KEY=
# LLM_API_BASE=http://localhost:1234/v1

# --- Azure OpenAI ---
# LLM_PROVIDER=azure
# LLM_MODEL=azure/your-deployment-name
# LLM_API_KEY=your-azure-key
# LLM_API_BASE=https://your-resource.openai.azure.com

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=anthropic/claude-3-sonnet-20240229
# LLM_API_KEY=your-anthropic-key
# LLM_API_BASE=

# --- Custom OpenAI-Compatible Server ---
# LLM_PROVIDER=custom
# LLM_MODEL=openai/your-model-name
# LLM_API_KEY=your-key-if-needed
# LLM_API_BASE=http://your-server:8000/v1
